# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# Email (SMTP) - for sending expense report submissions
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Expense Reporter <noreply@yourcompany.com>"
ADMIN_EMAIL="admin@yourcompany.com"

# OCR Provider: "tesseract" (default, local) | "google-vision" | "aws-textract"
OCR_PROVIDER="tesseract"

# Google Maps API Key - used for mileage distance calculation
# Get one at https://console.cloud.google.com/ (enable Distance Matrix API)
GOOGLE_MAPS_API_KEY=""

# Google Vision API (if OCR_PROVIDER=google-vision)
# GOOGLE_VISION_API_KEY=""

# AWS Textract (if OCR_PROVIDER=aws-textract)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"
